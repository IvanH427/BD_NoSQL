db.createCollection("ranking_vendedores");
db.Propiedades.aggregate([
{
    $group: {
        _id: "$vendedor_contacto",

        cantidad_propiedades: {
            $sum: 1
        },

        precio_promedio: {
            $avg: "$precio_dolar"
        }
    }
},
{
    $sort: {
        cantidad_propiedades: -1
    }
},
{
    $project: {
        _id: 0,
        vendedor: "$_id",
        cantidad_propiedades: 1,
        precio_promedio: 1
    }
},
{
    $out: "ranking_vendedores"
}
]);
db.createCollection("alertas_oportunidades");
db.Propiedades.aggregate([
{
    $lookup: {
        from: "estadisticas_mercado",
        localField: "provincia",
        foreignField: "provincia",
        as: "estadistica"
    }
},
{
    $unwind: "$estadistica"
},
{
    $match: {
        $expr: {
            $lt: [
                "$precio_dolar",
                { $multiply: ["$estadistica.precio_promedio_dolar", 0.75] }
            ]
        }
    }
},
{
    $project: {
        _id: 0,
        titulo: 1,
        provincia: 1,
        precio_propiedad: "$precio_dolar",
        precio_promedio_provincia:
            "$estadistica.precio_promedio_dolar",

        tipo_alerta: {
            $literal: "Precio inferior al promedio"
        },

        fecha_generacion: "$$NOW"
    }
},
{
    $out: "alertas_oportunidades"
}
]);
