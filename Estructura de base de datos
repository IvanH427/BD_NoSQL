db.createCollection("estadisticas_mercado");
db.propiedades.aggregate([
{
    $group: {
        _id: "$provincia",

        precio_promedio_colon: {
            $avg: "$precio_colon"
        },

        precio_promedio_dolar: {
            $avg: "$precio_dolar"
        },

        cantidad_propiedades: {
            $sum: 1
        },

        promedio_baños: {
            $avg: "$baños"
        },

        promedio_dormitorios: {
            $avg: "$dormitorios"
        },

        promedio_garajes: {
            $avg: "$garajes"
        }
    }
},
{
    $project: {
        _id: 0,
        provincia: "$_id",
        precio_promedio_colon: 1,
        precio_promedio_dolar: 1,
        cantidad_propiedades: 1,
        promedio_baños: 1,
        promedio_dormitorios: 1,
        promedio_garajes: 1
    }
},
{
    $out: "estadisticas_mercado"
}
]);
-------------------------------------------------------------------------
db.createCollection("tendencias_precio");
db.properties.aggregate([
{
    $addFields: {
        fecha_convertida: {
            $dateFromString: {
                dateString: "$fecha",
                format: "%d/%m/%Y"
            }
        }
    }
},
{
    $group: {
        _id: {
            año: { $year: "$fecha_convertida" },
            mes: { $month: "$fecha_convertida" },
            provincia: "$provincia"
        },

        precio_promedio_colon: {
            $avg: "$precio_colon"
        },

        precio_promedio_dolar: {
            $avg: "$precio_dolar"
        },

        cantidad_propiedades: {
            $sum: 1
        },

        fecha_captura: {
            $first: "$fecha"
        }
    }
},
{
    $project: {
        _id: 0,

        periodo: {
            $concat: [
                { $toString: "$_id.año" },
                "-",
                {
                    $cond: [
                        { $lt: ["$_id.mes", 10] },
                        {
                            $concat: [
                                "0",
                                { $toString: "$_id.mes" }
                            ]
                        },
                        {
                            $toString: "$_id.mes"
                        }
                    ]
                }
            ]
        },

        fecha_captura: 1,

        provincia: "$_id.provincia",

        precio_promedio_colon: {
            $round: ["$precio_promedio_colon", 2]
        },

        precio_promedio_dolar: {
            $round: ["$precio_promedio_dolar", 2]
        },

        cantidad_propiedades: 1,

        tipo_cambio_crc_usd: {
            $literal: 450.47
        }
    }
},
{
    $out: "tendencias_precio"
}
]);
